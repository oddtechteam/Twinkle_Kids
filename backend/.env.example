# Copy to backend/.env and adjust. Never commit the real .env file.
#
# The backend loads, in increasing priority:
#   <repo>/.env.local   Neon-managed values written by `neon deploy` / `neon env pull`
#   backend/.env        this file (app configuration)
#   process environment (what production hosts use)
# So with Neon linked, leave DATABASE_URL and AWS_* OUT of this file.

APP_ENV=development
DEBUG=true

# --- Database -------------------------------------------------------------------
# Provided by Neon in <repo>/.env.local:
#   DATABASE_URL           pooled endpoint (app traffic)
#   DATABASE_URL_UNPOOLED  direct endpoint (Alembic migrations)
# Credential-free fallbacks (uncomment ONE to override Neon locally):
# DATABASE_URL=sqlite:///./twinkle_dev.db
# DATABASE_URL=postgresql://twinkle:twinkle@localhost:5433/twinkle_kids   # docker compose up -d db
DATABASE_ECHO=false

# --- Object storage ---------------------------------------------------------------
# Provided by Neon in <repo>/.env.local (branch-scoped S3 credential):
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL_S3, AWS_REGION
# auto = Neon when those are present, otherwise in-memory (files not persisted).
STORAGE_BACKEND=auto
STORAGE_MEDIA_BUCKET=media
STORAGE_PRIVATE_BUCKET=assets
# Optional CDN origin in front of the public media bucket:
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.com
MEDIA_MAX_UPLOAD_BYTES=5242880

# --- Security ---------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-insecure-secret-change-me
# Temporary admin media API token (min 32 chars) until Phase 3 admin auth.
# Unset = admin endpoints disabled.
# ADMIN_API_TOKEN=

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
