# Copy to frontend/.env.local. Never commit real .env files.

# Used by Server Components / route handlers (not exposed to the browser).
API_BASE_URL=http://localhost:8000

# Browser calls go to the same origin (/api/v1/*) and are rewritten to API_BASE_URL.

# Public storefront origin for canonical URLs, Open Graph, structured data and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional CDN in front of public media (same value as the backend's MEDIA_PUBLIC_BASE_URL).
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.com
